# All settings are optional. The app works without them, using built-in
# explanations and skipping the Google speed test. In Render, add these under
# Environment -> Environment Variables. Never commit your real .env file.

# Claude-written reports (personalized summary + growth opportunities).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Which Claude model to use. Leave blank for the default (claude-sonnet-5-5).
ANTHROPIC_MODEL=

# Google PageSpeed Insights ("Speed & Accessibility" category). Free.
# Google Cloud Console -> enable "PageSpeed Insights API" -> Credentials ->
# Create API key -> restrict it to the PageSpeed Insights API.
GOOGLE_API_KEY=

# Max scans per visitor per hour (default 30). Protects your API usage.
SCAN_LIMIT_PER_HOUR=
